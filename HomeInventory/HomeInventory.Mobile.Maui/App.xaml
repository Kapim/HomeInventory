<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:HomeInventory.Mobile.Maui"
             xmlns:conv="clr-namespace:HomeInventory.Mobile.Maui.Converters"
             x:Class="HomeInventory.Mobile.Maui.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:InvertBoolConverter x:Key="InvertBool" />
            <conv:DepthToMarginConverter x:Key="DepthToMargin" />
            <conv:IntToBoolConverter x:Key="IntToBool" />
            <conv:StringToBoolConverter x:Key="StringToBool" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
