<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="HomeInventory.Mobile.Maui.Views.ItemsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:HomeInventory.Mobile.Maui.Views"
    xmlns:vm="clr-namespace:HomeInventory.Mobile.Maui.ViewModels"
    x:DataType="vm:ItemsViewModel"
    Title="{Binding LocationName}">

    <Shell.ToolbarItems>
        <ToolbarItem Text="+ Přidat" Command="{Binding AddItemCommand}" />
        <ToolbarItem Text="Smazat vybrané" Command="{Binding DeleteItemCommand}" Order="Secondary" />
    </Shell.ToolbarItems>

    <Grid RowDefinitions="Auto,*">
        <ActivityIndicator Grid.Row="0" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center" Margin="0,4" />

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Items}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedItem}"
                        Margin="8">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ItemViewModel">
                    <Border Margin="4,4"
                            Padding="12"
                            BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#242424}"
                            StrokeShape="RoundRectangle 10"
                            Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#444}">
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">

                            <!-- Name (editable) -->
                            <Entry Grid.Row="0" Grid.Column="0"
                                   Text="{Binding Name}"
                                   Placeholder="Název položky"
                                   FontSize="16" FontAttributes="Bold"
                                   ReturnType="Next" />

                            <!-- Quantity -->
                            <HorizontalStackLayout Grid.Row="0" Grid.Column="1"
                                                   Spacing="4" VerticalOptions="Center">
                                <Label Text="Qty:" FontSize="12" TextColor="Gray" VerticalOptions="Center" />
                                <Entry Text="{Binding Quantity}"
                                       WidthRequest="50"
                                       HorizontalTextAlignment="Center"
                                       Keyboard="Numeric"
                                       FontSize="14" />
                            </HorizontalStackLayout>

                            <!-- Description -->
                            <Entry Grid.Row="1" Grid.ColumnSpan="2"
                                   Text="{Binding Description}"
                                   Placeholder="Popis (volitelné)"
                                   FontSize="13"
                                   TextColor="Gray" />

                            <!-- Placement note -->
                            <Entry Grid.Row="2" Grid.ColumnSpan="2"
                                   Text="{Binding PlacementNote}"
                                   Placeholder="Umístění (volitelné)"
                                   FontSize="13"
                                   TextColor="Gray" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12" Margin="32">
                    <Label Text="Žádné položky" FontSize="18" TextColor="Gray" HorizontalOptions="Center" />
                    <Label Text="Přidejte první položku tlačítkem +"
                           FontSize="14" TextColor="Gray" HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>

</views:BasePage>
