<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="HomeInventory.Mobile.Maui.Views.ItemsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:HomeInventory.Mobile.Maui.Views"
    xmlns:vm="clr-namespace:HomeInventory.Mobile.Maui.ViewModels"
    xmlns:models="clr-namespace:HomeInventory.Client.Models;assembly=HomeInventory.Client"
    x:DataType="vm:ItemsViewModel"
    Title="{Binding LocationName}"
    BackgroundColor="{AppThemeBinding Light=#F4F4F8, Dark=#111118}">

    <Shell.ToolbarItems>
        <ToolbarItem Text="+ Přidat" Command="{Binding AddItemCommand}" />
        <ToolbarItem Text="Přesunout" Command="{Binding MoveItemCommand}" Order="Secondary" />
        <ToolbarItem Text="Smazat vybrané" Command="{Binding DeleteItemCommand}" Order="Secondary" />
        <ToolbarItem Text="🏷️ Štítky" Command="{Binding ManageHouseholdTagsCommand}" Order="Secondary" />
    </Shell.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Offline banner -->
        <Border Grid.Row="0"
                BackgroundColor="#EF4444"
                StrokeShape="RoundRectangle 0"
                Stroke="Transparent"
                Padding="16,8"
                IsVisible="{Binding IsOffline}">
            <Label Text="⚠️  Offline — změny nebudou uloženy"
                   TextColor="White"
                   FontSize="13"
                   HorizontalOptions="Center" />
        </Border>

        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           Margin="0,8" />

        <!-- Selection hint -->
        <Label Grid.Row="2"
               Text="Vybrány položky — použijte Přesunout nebo Smazat"
               IsVisible="{Binding HasSelectedItems}"
               FontSize="12"
               TextColor="{AppThemeBinding Light=#512BD4, Dark=#ac99ea}"
               HorizontalOptions="Center"
               Margin="0,4" />

        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding Items}"
                        SelectionMode="None"
                        Margin="12,4,12,0">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ItemViewModel">
                    <Border Margin="0,4"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1C2E}"
                            StrokeShape="RoundRectangle 12"
                            Stroke="{AppThemeBinding Light=#E4E4EE, Dark=#2A2A40}"
                            StrokeThickness="1"
                            Padding="12">

                        <Grid ColumnDefinitions="*,Auto">

                            <!-- Main content -->
                            <Grid Grid.Column="0"
                                  RowDefinitions="Auto,Auto,Auto,Auto"
                                  ColumnDefinitions="*,Auto"
                                  RowSpacing="4">

                                <!-- Name -->
                                <Entry Grid.Row="0" Grid.Column="0"
                                       Text="{Binding Name}"
                                       Placeholder="Název položky"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       ReturnType="Next" />

                                <!-- Quantity -->
                                <HorizontalStackLayout Grid.Row="0" Grid.Column="1"
                                                       Spacing="4"
                                                       VerticalOptions="Center"
                                                       Margin="8,0,0,0">
                                    <Label Text="ks:"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#888, Dark=#888}"
                                           VerticalOptions="Center" />
                                    <Entry Text="{Binding Quantity}"
                                           WidthRequest="48"
                                           HorizontalTextAlignment="Center"
                                           Keyboard="Numeric"
                                           FontSize="14" />
                                </HorizontalStackLayout>

                                <!-- Description -->
                                <Entry Grid.Row="1" Grid.ColumnSpan="2"
                                       Text="{Binding Description}"
                                       Placeholder="Popis (volitelné)"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light=#666, Dark=#AAA}" />

                                <!-- Placement note -->
                                <Entry Grid.Row="2" Grid.ColumnSpan="2"
                                       Text="{Binding PlacementNote}"
                                       Placeholder="Umístění (volitelné)"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light=#666, Dark=#AAA}" />

                                <!-- Tag chips row -->
                                <FlexLayout Grid.Row="3" Grid.ColumnSpan="2"
                                            BindableLayout.ItemsSource="{Binding Tags}"
                                            Wrap="Wrap"
                                            Direction="Row"
                                            JustifyContent="Start"
                                            AlignItems="Center"
                                            Margin="0,4,0,0">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:Tag">
                                            <Border Padding="6,2"
                                                    Margin="0,2,4,2"
                                                    StrokeShape="RoundRectangle 10"
                                                    StrokeThickness="0">
                                                <Border.BackgroundColor>
                                                    <Binding Path="Color" />
                                                </Border.BackgroundColor>
                                                <Label Text="{Binding Name}"
                                                       TextColor="White"
                                                       FontSize="11"
                                                       FontAttributes="Bold" />
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>

                            </Grid>

                            <!-- Right column: checkbox + tag button -->
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="4"
                                                 VerticalOptions="Start"
                                                 Margin="8,0,0,0">

                                <CheckBox IsChecked="{Binding IsSelected}"
                                          HorizontalOptions="Center" />

                                <Button Text="🏷️"
                                        FontSize="16"
                                        BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light=#512BD4, Dark=#ac99ea}"
                                        Padding="0"
                                        HeightRequest="32"
                                        WidthRequest="36"
                                        CommandParameter="{Binding .}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ItemsViewModel}}, Path=ManageTagsCommand}" />

                            </VerticalStackLayout>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                                     Spacing="14" Margin="40">
                    <Label Text="📦"
                           FontSize="48"
                           HorizontalOptions="Center" />
                    <Label Text="Žádné položky"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#444, Dark=#AAA}"
                           HorizontalOptions="Center" />
                    <Label Text="Přidejte první položku tlačítkem +"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light=#888, Dark=#666}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

        </CollectionView>

    </Grid>

</views:BasePage>
