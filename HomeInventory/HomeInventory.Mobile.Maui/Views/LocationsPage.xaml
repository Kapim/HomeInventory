<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="HomeInventory.Mobile.Maui.Views.LocationsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:HomeInventory.Mobile.Maui.Views"
    xmlns:vm="clr-namespace:HomeInventory.Mobile.Maui.ViewModels"
    x:DataType="vm:LocationsViewModel"
    Title="Lokace">

    <Shell.ToolbarItems>
        <ToolbarItem Text="+ Lokace" Command="{Binding AddRootLocationCommand}" />
        <ToolbarItem Text="Přepnout domácnost" Command="{Binding SwitchHouseholdCommand}" Order="Secondary" />
        <ToolbarItem Text="Odhlásit" Command="{Binding LogoutCommand}" Order="Secondary" />
    </Shell.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*"
          BackgroundColor="{AppThemeBinding Light=#F4F4F8, Dark=#111118}">

        <!-- Offline banner -->
        <Border Grid.Row="0"
                BackgroundColor="#EF4444"
                StrokeShape="RoundRectangle 0"
                Stroke="Transparent"
                Padding="16,8"
                IsVisible="{Binding IsOffline}">
            <Label Text="⚠️  Offline — změny nebudou uloženy"
                   TextColor="White"
                   FontSize="13"
                   HorizontalOptions="Center" />
        </Border>

        <!-- Household chip -->
        <Border Grid.Row="1"
                IsVisible="{Binding HouseholdName, Converter={StaticResource StringToBool}}"
                BackgroundColor="{AppThemeBinding Light=#EEF0FF, Dark=#1E1E35}"
                StrokeShape="RoundRectangle 20"
                Stroke="Transparent"
                HorizontalOptions="Center"
                Padding="14,5"
                Margin="0,10,0,2">
            <Label Text="{Binding HouseholdName}"
                   FontSize="12"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#512BD4, Dark=#ac99ea}" />
        </Border>

        <ActivityIndicator Grid.Row="2"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           Margin="0,8" />

        <!-- Move mode banner -->
        <Border Grid.Row="3"
                BackgroundColor="#FF9800"
                StrokeShape="RoundRectangle 0"
                Stroke="Transparent"
                Padding="16,10"
                IsVisible="{Binding IsMovingLocation}">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       Text="Vyberte cílovou lokaci nebo zrušte přesun"
                       TextColor="White"
                       FontSize="13"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="Zrušit"
                        Command="{Binding CancelMoveLocationCommand}"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        FontSize="13"
                        Padding="8,0" />
            </Grid>
        </Border>

        <CollectionView Grid.Row="4"
                        ItemsSource="{Binding FlatLocations}"
                        SelectionMode="None"
                        Margin="0,4,0,0">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:LocationNodeViewModel">
                    <Grid Padding="12,3"
                          Margin="{Binding Depth, Converter={StaticResource DepthToMargin}}">

                        <SwipeView>
                            <!-- Swipe left → edit, move, delete -->
                            <SwipeView.RightItems>
                                <SwipeItems Mode="Reveal">
                                    <SwipeItem Text="Upravit"
                                               BackgroundColor="#512BD4"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LocationsViewModel}}, Path=OpenLocationDetailCommand}"
                                               CommandParameter="{Binding .}" />
                                    <SwipeItem Text="Přesunout"
                                               BackgroundColor="#FF9800"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LocationsViewModel}}, Path=StartMoveLocationNodeCommand}"
                                               CommandParameter="{Binding .}" />
                                    <SwipeItem Text="Smazat"
                                               BackgroundColor="#EF4444"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LocationsViewModel}}, Path=DeleteLocationNodeCommand}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <!-- Swipe right → add child -->
                            <SwipeView.LeftItems>
                                <SwipeItems Mode="Reveal">
                                    <SwipeItem Text="+ Podlokaci"
                                               BackgroundColor="#22C55E"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LocationsViewModel}}, Path=AddChildLocationNodeCommand}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.LeftItems>

                            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1C2E}"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="{AppThemeBinding Light=#E4E4EE, Dark=#2A2A40}"
                                    StrokeThickness="1"
                                    Padding="0">

                                <Grid ColumnDefinitions="64,*,40" MinimumHeightRequest="58">

                                    <!-- Chevron toggle — expand/collapse, only when has children -->
                                    <Grid Grid.Column="0"
                                          IsVisible="{Binding HasChildren}">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LocationsViewModel}}, Path=ToggleExpandCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <Label Text="{Binding ChevronText}"
                                               TextColor="{AppThemeBinding Light=#512BD4, Dark=#ac99ea}"
                                               FontSize="16"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Grid>

                                    <!-- Main content: folder icon + name -->
                                    <Grid Grid.Column="1"
                                          ColumnDefinitions="Auto,*"
                                          Padding="0,10,4,10">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LocationsViewModel}}, Path=HandleTapCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>

                                        <Label Grid.Column="0"
                                               Text="{Binding TypeIcon}"
                                               FontSize="17"
                                               VerticalOptions="Center"
                                               Margin="0,0,10,0" />

                                        <Label Grid.Column="1"
                                               Text="{Binding Name}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center"
                                               LineBreakMode="TailTruncation" />
                                    </Grid>

                                    <!-- Navigate arrow -->
                                    <Label Grid.Column="2"
                                           Text="›"
                                           TextColor="{AppThemeBinding Light=#BBBBCC, Dark=#44445A}"
                                           FontSize="22"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LocationsViewModel}}, Path=HandleTapCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Label.GestureRecognizers>
                                    </Label>

                                </Grid>
                            </Border>
                        </SwipeView>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                                     Spacing="14" Margin="40">
                    <Label Text="🗂️"
                           FontSize="48"
                           HorizontalOptions="Center" />
                    <Label Text="Žádné lokace"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#444, Dark=#AAA}"
                           HorizontalOptions="Center" />
                    <Label Text="Přidejte první lokaci tlačítkem + Lokace"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light=#888, Dark=#666}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

        </CollectionView>

    </Grid>

</views:BasePage>
