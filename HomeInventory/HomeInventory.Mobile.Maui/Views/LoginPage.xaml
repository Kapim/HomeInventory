<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="HomeInventory.Mobile.Maui.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:HomeInventory.Mobile.Maui.Views"
    xmlns:vm="clr-namespace:HomeInventory.Mobile.Maui.ViewModels"
    x:DataType="vm:LoginViewModel"
    Title="Přihlášení"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <Grid RowDefinitions="*,Auto,*" Padding="32" MinimumHeightRequest="500">

            <!-- Header -->
            <VerticalStackLayout Grid.Row="0" VerticalOptions="End" Spacing="8" Margin="0,0,0,32">
                <Label Text="HomeInventory"
                       FontSize="32" FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light=#512BD4, Dark=#A78BFA}" />
                <Label Text="Správa domácnosti"
                       FontSize="14" HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light=#666, Dark=#AAA}" />
            </VerticalStackLayout>

            <!-- Form -->
            <VerticalStackLayout Grid.Row="1" Spacing="12">

                <!-- Server URL -->
                <Label Text="Adresa serveru" FontSize="12" TextColor="Gray" Margin="4,0,0,0" />
                <Border Stroke="{AppThemeBinding Light=#DDD, Dark=#444}"
                        StrokeThickness="1" StrokeShape="RoundRectangle 8">
                    <Entry Placeholder="http://192.168.1.x:5046/"
                           Text="{Binding ServerUrl}"
                           Keyboard="Url"
                           ReturnType="Next"
                           Margin="12,4" />
                </Border>

                <!-- Username -->
                <Label Text="Uživatelské jméno" FontSize="12" TextColor="Gray" Margin="4,0,0,0" />
                <Border Stroke="{AppThemeBinding Light=#DDD, Dark=#444}"
                        StrokeThickness="1" StrokeShape="RoundRectangle 8">
                    <Entry Placeholder="uživatel"
                           Text="{Binding UserName}"
                           ReturnType="Next"
                           Margin="12,4" />
                </Border>

                <!-- Password -->
                <Label Text="Heslo" FontSize="12" TextColor="Gray" Margin="4,0,0,0" />
                <Border Stroke="{AppThemeBinding Light=#DDD, Dark=#444}"
                        StrokeThickness="1" StrokeShape="RoundRectangle 8">
                    <Entry Placeholder="heslo"
                           Text="{Binding Password}"
                           IsPassword="True"
                           ReturnType="Done"
                           ReturnCommand="{Binding LoginCommand}"
                           Margin="12,4" />
                </Border>

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   HorizontalOptions="Center" Margin="0,4" />

                <Button Text="Přihlásit se"
                        Command="{Binding LoginCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}"
                        BackgroundColor="{AppThemeBinding Light=#512BD4, Dark=#7C3AED}"
                        TextColor="White"
                        CornerRadius="8"
                        HeightRequest="48"
                        Margin="0,8,0,0" />
            </VerticalStackLayout>

            <BoxView Grid.Row="2" IsVisible="False" />
        </Grid>
    </ScrollView>

</views:BasePage>
