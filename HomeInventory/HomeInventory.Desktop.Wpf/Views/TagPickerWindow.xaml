<Window x:Class="HomeInventory.Desktop.Wpf.Views.TagPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HomeInventory.Desktop.Wpf.Views"
        xmlns:conv="clr-namespace:HomeInventory.Desktop.Wpf.Converters"
        Title="Štítky"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="400"
        MaxHeight="640"
        Background="#F5F7FB">

    <Window.Resources>
        <conv:HexColorConverter x:Key="HexColor"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="40" MaxHeight="320"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" x:Name="HeaderText"
                   FontSize="15" FontWeight="SemiBold"
                   Foreground="#172033" Margin="0,0,0,12"/>

        <!-- Tag list -->
        <Border Grid.Row="2"
                BorderBrush="#D8E0EA" BorderThickness="1"
                CornerRadius="6" Background="White">
            <ListBox x:Name="TagList"
                     ItemsSource="{Binding TagChoices}"
                     SelectionMode="Single"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#EEF3F8"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      VerticalAlignment="Center"/>
                            <Ellipse Grid.Column="1"
                                     Width="12" Height="12"
                                     Margin="8,0,6,0"
                                     VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <Binding Path="Color" Converter="{StaticResource HexColor}"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Name}"
                                       VerticalAlignment="Center"
                                       FontSize="13"/>
                            <Button Grid.Column="3"
                                    Content="✕"
                                    FontSize="11"
                                    Width="22" Height="22"
                                    Padding="0"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip="Smazat štítek"
                                    Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"
                                    Click="DeleteTag_Click"
                                    Tag="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Empty state -->
        <TextBlock Grid.Row="2"
                   Text="Žádné štítky — vytvořte první níže"
                   FontSize="12" Foreground="#667085"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding HasNoTags, Converter={StaticResource BoolToVis}}"/>

        <!-- New tag form -->
        <Expander Grid.Row="3" Header="Nový štítek" Margin="0,12,0,0">
            <Border Background="White" BorderBrush="#D8E0EA" BorderThickness="1"
                    CornerRadius="6" Padding="12" Margin="0,6,0,0">
                <StackPanel>
                    <TextBox x:Name="NewTagName"
                             materialDesign:HintAssist.Hint="Název (max 30 znaků)"
                             MaxLength="30"
                             FontSize="13"
                             Margin="0,0,0,10"
                             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"/>

                    <TextBlock Text="Barva:" FontSize="12" Foreground="#667085" Margin="0,0,0,6"/>
                    <ItemsControl x:Name="ColorPicker" ItemsSource="{Binding AvailableColors}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="24" Height="24" CornerRadius="12" Margin="3"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="ColorChoice_Click"
                                        Tag="{Binding Hex}"
                                        ToolTip="{Binding Name}">
                                    <Border.Background>
                                        <Binding Path="Hex" Converter="{StaticResource HexColor}"/>
                                    </Border.Background>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#172033"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="+ Přidat štítek"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            Click="AddTag_Click"
                            Style="{StaticResource PrimaryActionButton}"/>
                </StackPanel>
            </Border>
        </Expander>

        <!-- OK / Cancel -->
        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Zrušit" IsCancel="True" Width="90" Margin="0,0,8,0"/>
            <Button Content="OK" IsDefault="True" Width="90" Click="OK_Click"
                    Style="{StaticResource PrimaryActionButton}"/>
        </StackPanel>
    </Grid>
</Window>
