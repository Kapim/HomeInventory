# Copy to `.env` (same folder as docker-compose.yml) and fill in real secrets.
# docker compose automatically reads .env.

# Postgres password (used by both the DB and the API connection string).
POSTGRES_PASSWORD=change-me-strong-password

# JWT signing key — must be a long random string. Rotating it invalidates all tokens.
JWT_SECRET=please-generate-a-long-random-secret-at-least-32-chars

# Host port for Postgres (container is always 5432). Change if 5433 is also taken.
POSTGRES_HOST_PORT=5433
